{
  "expo": {
    "name": "မြန်မာ့ကျားကွက်",
    "slug": "burmese-checker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8518084536991465~7285099854",
          "iosAppId": "ca-app-pub-8518084536991465~7285099854"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "barStyle": "light",
          "enforceContrast": false
        }
      ]
    ],
    "android": {
      "package": "com.minthangml.burmesechecker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#120d0a"
      }
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    }
  }
}
