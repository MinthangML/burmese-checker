{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["*.js", "app/**/*.js", "src/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "supabase/functions/**"]
}
